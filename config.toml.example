# uping v0.3.2 — example configuration
#
# Copy:   cp config.toml.example config.toml
# Run:    ./target/release/uping config.toml
# Check:  ./target/release/uping --check config.toml
# DNS:    ./target/release/uping --dns-zone config.toml   (hosts records)
# Apply:  pkill -HUP -x uping               (SIGHUP, no restart)
# Restart only after installing a new binary, or after changing [listen],
# a server's https_listen/https_listen6, [acme]/[acme.internal], or [[stream]].
#
# Every path (certificates, static roots, cert_dir, CA bundles) is resolved
# from the directory that holds this file. An absolute path is used as written,
# so /srv/www and ~/uping/cert work exactly as expected.

# Optional. Host-wide listeners. One address per family, one port per protocol.
# There is no wildcard and no list: a domain that needs another address or port
# overrides it with `https_listen` / `https_listen6` below. For an ACME server,
# that same IP is also bound on `http`: a private site on 10.8.0.1:443 gets
# 10.8.0.1:80 automatically for http-01.
# [listen]
# ipv4  = "0.0.0.0"                # default
# ipv6  = "2607:f1c0:f031:4500::1" # omit for no IPv6
# http  = 80                       # default
# https = 443                      # default

# Optional. The public ACME CA, used by keys = "auto".
# [acme]
# email             = "ops@rao-nagos.pf"
# staging           = false        # Let's Encrypt staging: untrusted test certs
# cert_dir          = "cert"       # <this file's directory>/cert/<domain>/
# renew_before_days = 30           # clamped to 1..=89
# directory         = ""           # another public ACME directory URL
# ca_bundle         = ""           # PEM root for the ACME server; empty = system roots

# Optional. A private ACME CA, selected by keys = "internal" (alias "step-ca").
# uping does NOT create the step-ca root or a client certificate. Run
# `sudo step ca init --deployment-type standalone --acme` once, copy its root
# certificate (root_ca.crt, public part only; not intermediate_ca.crt alone)
# where uping can read it, and point `ca_bundle` at that file. `ca_bundle` only
# lets uping trust the ACME API's TLS certificate; it is not pushed to clients.
# The leaf for the domain is requested and renewed by uping automatically.
# [acme.internal]
# directory = "https://step-ca.internal/acme/acme/directory"
# ca_bundle = "cert/step-ca-root.pem"
#
# keys = "internal" still uses http-01: step-ca must resolve the name (internal
# DNS) and reach the host on port 80. If it cannot, use keys = "manual".

# Optional. Abuse protection, counted per client IP over a 1-second window.
# Set any of them to 0 to switch that limit off.
# [limits]
# per_ip_rps          = 300        # requests/sec per IP, then 429
# per_ip_conns_per_sec = 100       # new TCP connections/sec per IP, then dropped
# max_body_bytes      = 10485760   # 10 MiB, then 413

# Optional. TLS behaviour. `fallback_cert` is listener-wide: it answers a
# missing/unknown SNI before a domain exists, so it cannot be set per server.
# [tls]
# fallback_cert = true             # serve the first cert when SNI is absent/unknown

# Optional. Upstream liveness. A backend is marked down after `failures`
# consecutive failed probes and answered with 503 until it returns.
# interval_ms = 0 disables the active probe (the address is still resolved).
# [health]
# interval_ms = 5000
# timeout_ms  = 2000
# failures    = 2

[[server]]
domain   = "www.rao-nagos.pf"
keys     = "auto"                 # default when no pub_key/priv_key are given
upstream = "127.0.0.1:8080"       # catch-all: every path without its own route

# Optional. Per-domain overrides of [limits] and [health]. Every omitted field
# keeps the global value. `per_ip_conns_per_sec` is host-wide and cannot be set
# here: it runs at TCP accept, before the Host header is known.
# limits = { per_ip_rps = 1220, max_body_bytes = 0 }
# health = { interval_ms = 10000, failures = 3 }
# health = false                  # keep resolving, but never 503 this backend

# Optional. Give this domain its own HTTPS listener instead of the global one.
# `https_listen` is IPv4, `https_listen6` is IPv6; each may carry a port, which
# defaults to `[listen] https`. HTTP stays host-wide: it is the redirect and the
# ACME challenge listener. For an ACME server, this same IP is also bound on
# `[listen] http` so http-01 can follow the domain onto this address, unless
# `serve_http = false` removes this domain from port 80.
# https_listen  = "203.0.113.10"
# https_listen6 = "[2001:db8::10]:8443"
# serve_http    = false           # no :80 vhost (private/VPN site; needs manual keys)

# Optional. Speak HTTPS to the backend instead of plain HTTP.
# upstream_tls    = true
# upstream_sni    = "app.internal"       # default: the upstream host, or this domain for an IP
# upstream_verify = true                 # false accepts any certificate: private nets only
# upstream_ca     = "certs/internal-ca.pem"   # replaces the system roots

# Optional. One target per path prefix. The longest prefix wins, and a prefix
# only matches whole segments: /mcp covers /mcp and /mcp/sse, not /mcpx.
# `routes` is the ONLY route form: an array of inline tables inside the server.
# strip_prefix: /assets/app.css -> public/assets/app.css.
# routes = [
#   { path = "/mcp", upstream = "127.0.0.1:8081" },
#   { path = "/assets", root = "public/assets", strip_prefix = true },
# ]

# A static site: no backend, just files. Exactly one of upstream/root.
#
# [[server]]
# domain = "static.rao-nagos.pf"
# keys   = "auto"
# root   = "public"               # relative to this file, or absolute
# index  = "index.html"

# Manual certificates: point at the two PEM files and renew them yourself.
#
# [[server]]
# domain   = "manual.rao-nagos.pf"
# keys     = "manual"
# pub_key  = "cert/manual.rao-nagos.pf/fullchain.pem"
# priv_key = "cert/manual.rao-nagos.pf/privkey.pem"
# upstream = "127.0.0.1:8080"

# A private site on a VPN address, with a certificate from an internal ACME CA.
# keys = "internal" still uses http-01, so the CA must reach this domain on
# port 80. If it cannot, issue the pair out of band and use keys = "manual".
#
# [[server]]
# domain        = "app.vpn.rao-nagos.pf"
# keys          = "internal"
# upstream      = "127.0.0.1:8080"
# https_listen  = "10.8.0.1"      # the rupa VPN address
# limits        = { per_ip_rps = 50 }
# health        = { interval_ms = 15000 }

# EXPERIMENTAL in v0.3. Raw TCP forwarding: one listener per entry, no TLS
# termination. `listen` is one concrete `IP:port`; an `upstream` must name a
# real peer.
#
# [[stream]]
# name     = "smtp"
# listen   = "0.0.0.0:25"
# upstream = "127.0.0.1:10025"
# connect_timeout_ms = 5000      # optional, default 5000, clamped 100..30000
