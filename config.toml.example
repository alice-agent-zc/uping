# uping v0.4.0 — configuration reference
#
# This is the template shipped as /usr/share/uping/config.toml.example. The
# package installs a working loopback default at /etc/uping/config.toml; start
# from this file when you replace it with real names.
#
# Check:    sudo -u uping /usr/bin/uping --check /etc/uping/config.toml
# Apply:    sudo systemctl reload uping      (SIGHUP; no connection drop)
# Restart:  sudo systemctl restart uping     (new binary, [listen],
#           https_listen/https_listen6, [acme], [internal] or [[stream]])
#
# Every relative path resolves against the directory holding this file. The
# service user cannot write /etc, so everything uping writes — the ACME
# directory, the local CA and its leaves — lives under /var/lib/uping.
# A ~/uping checkout can use the same file with /var/lib/uping replaced by the
# checkout directory.

[listen]
# The public address of this host. A per-server `https_listen` cannot be a
# second address on a wildcard listener, so the global one is concrete; replace
# the placeholder with your address.
ipv4  = "203.0.113.10"
http  = 80
https = 443
# ipv6 = "2607:f1c0:f031:4500::1"   # omit for no IPv6

# Public names: Let's Encrypt (or [acme] directory). http-01 needs the domain
# to resolve publicly and port 80 to be reachable.
[acme]
email             = "ops@rao-nagos.pf"
cert_dir          = "/var/lib/uping/cert"
renew_before_days = 30
# staging   = false
# directory = ""                    # another public ACME directory URL
# ca_bundle = ""                    # PEM root for that server; empty = system roots

# Private names: uping signs them itself, with no ACME server and no network.
# `domain` is the only zone this CA signs: every `keys = "internal"` server
# must be that name or a subdomain of it.
[internal]
domain      = "internal.rao-nagos.pf"
ca_dir      = "/var/lib/uping/internal/ca"
cert_dir    = "/var/lib/uping/internal"
ca_days     = 3650                # root lifetime
intermediate_days = 1825          # intermediate that signs the leaves
leaf_days   = 397                 # 398 is the Apple/Safari ceiling

# Optional identity written into the root, the intermediate and the leaves.
# Every field defaults to empty and is omitted when empty, so nothing blocks a
# first start. `common_name` overrides the root's derived CN only.
# common_name         = "rao-nagos internal Root CA"
# organization        = "rao-nagos"
# organizational_unit = "Infrastructure"
# country             = "PF"
# state               = "Windward Islands"
# locality            = "Papeete"
# email               = "ops@rao-nagos.pf"
renew_before_days = 30
key_type    = "ed25519"           # ed25519 | p256 | rsa2048
# The root is downloadable at https://internal.rao-nagos.pf:9000/root.crt.
# The endpoint is a name inside the zone, so it presents a certificate from
# this same CA; the first fetch needs `curl -k`.
serve_root  = "https://internal.rao-nagos.pf:9000"

[limits]
per_ip_rps           = 300        # requests/sec per client IP
per_ip_conns_per_sec = 100        # new TCP connections/sec per client IP
max_body_bytes       = 10485760   # 10 MiB; 0 = unlimited

[health]
interval_ms = 5000                # 0 disables the active probe
timeout_ms  = 2000
failures    = 2

[tls]
fallback_cert = true              # answer missing/unknown SNI with the first cert

# A public site: ACME issues and renews the certificate over http-01.
[[server]]
domain   = "www.rao-nagos.pf"
keys     = "auto"
upstream = "127.0.0.1:8080"

# Optional per-domain overrides.
# limits = { per_ip_rps = 1220, max_body_bytes = 0 }
# health = { interval_ms = 10000, failures = 3 }   # or `health = false`
# https_listen  = "203.0.113.10"   # own HTTPS socket
# https_listen6 = "[2001:db8::10]:8443"
# routes = [
#   { path = "/mcp", upstream = "127.0.0.1:8081" },
#   { path = "/assets", root = "/srv/www/assets", strip_prefix = true },
# ]

# A private site on the VPN address, signed by the local CA. No http-01, so no
# port 80 is needed. `alt_names` adds SANs to the same leaf.
[[server]]
domain       = "dsh.internal.rao-nagos.pf"
keys         = "internal"
alt_names    = ["terminal.internal.rao-nagos.pf"]
upstream     = "127.0.0.1:7681"
https_listen = "10.8.0.1"
serve_http   = false

# A static site: exactly one of upstream/root.
# [[server]]
# domain = "static.rao-nagos.pf"
# keys   = "auto"
# root   = "/srv/www"
# index  = "index.html"

# Manual certificates: point at the two PEM files and renew them yourself.
# [[server]]
# domain   = "manual.rao-nagos.pf"
# keys     = "manual"
# pub_key  = "/var/lib/uping/manual/fullchain.pem"
# priv_key = "/var/lib/uping/manual/privkey.pem"
# upstream = "127.0.0.1:8080"

# HTTPS to the backend instead of plain HTTP.
# upstream_tls    = true
# upstream_sni    = "app.internal.rao-nagos.pf"
# upstream_verify = true
# upstream_ca     = "/var/lib/uping/upstream-ca.pem"

# Raw TCP forwarding: one listener per entry, no TLS termination, half-close
# forwarded. `listen` is one concrete IP:port, `upstream` a real peer.
# [[stream]]
# name     = "smtp"
# listen   = "0.0.0.0:25"
# upstream = "127.0.0.1:10025"
# connect_timeout_ms = 5000       # default 5000, clamped 100..30000
