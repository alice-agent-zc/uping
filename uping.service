# uping — systemd unit for the root install.
#
# Install:
#   sudo install -m644 uping.service /etc/systemd/system/uping.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now uping
#
# The process runs as root and binds 80/443 directly: no CAP_NET_BIND_SERVICE,
# no setcap. It is ordered after rupa.service so a VPN address such as
# 10.8.0.1 exists before uping binds it.
#
# Apply an edited config without dropping connections:
#   sudo systemctl reload uping
# A new binary, or a change to [listen], https_listen/https_listen6,
# [acme]/[acme.internal] or [[stream]], needs a restart:
#   sudo systemctl restart uping

[Unit]
Description=uping reverse proxy
Documentation=https://github.com/raonagos/uping
After=network-online.target rupa.service
Wants=network-online.target rupa.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/etc/uping
ExecStart=/usr/bin/uping /etc/uping/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
