# uping — default configuration installed by the Debian package.
#
# It is deliberately harmless: loopback only, a static page on
# https://localhost:8443, and a certificate from uping's own CA (no ACME, no
# network). It exists so that `dpkg -i` leaves a working service you can look
# at before you have decided on any domain.
#
# Replace this file with your own when you are ready:
#   sudo editor /etc/uping/config.toml
#   sudo -u uping /usr/bin/uping --check /etc/uping/config.toml
#   sudo systemctl restart uping
#
# The commented template is /usr/share/uping/config.toml.example.

[listen]
ipv4  = "127.0.0.1"
http  = 8080
https = 8443

# uping's own CA. Clients install /var/lib/uping/internal/ca/root.crt once.
[internal]
ca_dir   = "/var/lib/uping/internal/ca"
cert_dir = "/var/lib/uping/internal"

[[server]]
domain     = "localhost"
keys       = "internal"
root       = "/usr/share/uping/www"
serve_http = false
